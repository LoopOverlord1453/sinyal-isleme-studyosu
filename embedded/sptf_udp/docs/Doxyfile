# SPTF-UDP gömülü kütüphanesi — Doxygen yapılandırması
# Kullanım (embedded/sptf_udp klasöründe):  doxygen docs/Doxyfile   → çıktı: docs/api/html/index.html

PROJECT_NAME           = "SPTF-UDP"
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Signal Processing Toolbox için gömülü UDP gönderici kütüphanesi"
OUTPUT_DIRECTORY       = docs/api
OUTPUT_LANGUAGE        = Turkish
INPUT_ENCODING         = UTF-8

INPUT                  = docs/mainpage.md \
                         include \
                         port/lwip_raw \
                         port/socket \
                         examples/stm32_lwip_raw
FILE_PATTERNS          = *.h *.c *.md
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md
EXCLUDE_SYMBOLS        = SPTF_PRIV_*

OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = NO
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
EXTRACT_PRIVATE        = NO
INTERNAL_DOCS          = NO
JAVADOC_AUTOBRIEF      = NO
MARKDOWN_SUPPORT       = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
SORT_MEMBER_DOCS       = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = __DOXYGEN__ \
                         SPTF_CFG_CRC=1 \
                         "SPTF_LWIP_LOCK()=" \
                         "SPTF_LWIP_UNLOCK()="
INCLUDE_PATH           = include

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = AUTO_DARK
GENERATE_LATEX         = NO
HAVE_DOT               = NO
